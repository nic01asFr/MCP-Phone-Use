<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="device-agent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Non connecte"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/serverUrlField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="URL du relais (https://...)"
        android:inputType="textUri" />

    <EditText
        android:id="@+id/enrollmentCodeField"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Code d'enrolement"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/enrollButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enroler cet appareil"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/connectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Connecter"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/disconnectButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Deconnecter"
        android:layout_marginTop="8dp" />

</LinearLayout>
