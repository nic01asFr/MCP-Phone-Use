<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Bloc hero : icone + etat + client + action de connexion, fusionnes -->
    <LinearLayout
        android:id="@+id/heroContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingTop="12dp"
        android:paddingBottom="28dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="14dp"
            android:clipChildren="false"
            android:clipToPadding="false">
            <View
                android:id="@+id/heroPulseRing"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_pulse_ring"
                android:visibility="invisible" />
            <View
                android:id="@+id/heroOrbBackground"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_orb_disconnected" />
            <ImageView
                android:id="@+id/heroOrbIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_mcp_logo" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MCP Phone Use"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/heroStatusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Non connecte"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/heroSubText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="appuie pour connecter"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary" />

    </LinearLayout>

    <!-- Carte : ajouter un appareil -->
    <LinearLayout
        android:id="@+id/enrollCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_row_active"
        android:padding="18dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ajouter cet appareil"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:text="Demande le code a ton assistant, puis saisis-le ici pour l'autoriser sur ce telephone."
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <EditText
            android:id="@+id/serverUrlInput"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:visibility="gone"
            android:hint="URL du relais" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_row_inactive"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/enrollmentCodeInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:background="@android:color/transparent"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:hint="Code d'appairage" />
        </FrameLayout>

        <TextView
            android:id="@+id/enrollButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_row_inactive"
            android:padding="13dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:text="Valider le code"
            android:textColor="@color/accent_blue_light"
            android:textStyle="bold"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- Ligne fusionnee : controle de l'ecran (accessibilite) -->
    <LinearLayout
        android:id="@+id/accessibilityRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_row_active"
        android:padding="14dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/accessibilityIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_eye" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/accessibilityMainText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Controle de l'ecran"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/accessibilitySubText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="desactive — appuie pour l'activer"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- Ligne fusionnee : capture d'ecran (MediaProjection) -->
    <LinearLayout
        android:id="@+id/captureRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_row_active"
        android:padding="14dp"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_icon_circle"
            android:layout_marginEnd="12dp">
            <ImageView
                android:id="@+id/captureIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_camera" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capture d'ecran"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />
            <TextView
                android:id="@+id/screenCaptureStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="non armee — appuie pour armer"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/text_secondary" />
        </LinearLayout>
    </LinearLayout>


    <TextView
        android:id="@+id/versionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text=""
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:textColor="@color/text_secondary" />

</LinearLayout>
</ScrollView>
